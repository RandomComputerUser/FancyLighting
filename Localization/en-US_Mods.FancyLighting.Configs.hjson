Snippets: {
	HighPerformanceImpact: "[c/FFD080:This setting has a] [c/FFA000:high impact] [c/FFD080:on performance]"
	SignificantPerformanceEffect: "[c/FFFF80:This setting has a] [c/FFFF00:significant effect] [c/FFFF80:on performance]"
	PerformanceBenefit: "[c/80FF80:This setting] [c/00FF00:benefits] [c/80FF80:performance]"
	SmoothLighting: "{$LightingConfig.UseSmoothLighting.Label}"
	RenderMode: "{$LightingConfig.LightMapRenderMode.Label}"
	LightMapBlurring: "{$LightingConfig.UseLightMapBlurring.Label}"
	NormalMaps: "{$LightingConfig.SimulateNormalMaps.Label}"
	AmbientOcclusion: "{$LightingConfig.UseAmbientOcclusion.Label}"
	FancyLightingEngine: "{$LightingConfig.UseFancyLightingEngine.Label}"
	GlobalIllumination: "{$LightingConfig.SimulateGlobalIllumination.Label}"
	FancySky: "{$LightingConfig.Headers.FancySky}"
	FancyAtmosphere: "{$LightingConfig.UseFancySkyRendering.Label}"
	FancySkyLightColors: "{$LightingConfig.UseFancySkyColors.Label}"
	FancySkyLightShading: "{$LightingConfig.UseFancySkyLighting.Label}"
	BasicHdr: "{$RenderMode.BicubicOverbright.Label}"
	FullHdr: "{$RenderMode.EnhancedHdr.Label}"
	RequireRenderModeHdr: "[c/FF00FF:{$Snippets.RenderMode}] [c/FF80FF:must be set to] [c/FF00FF:{$Snippets.BasicHdr}] [c/FF80FF:or] [c/FF00FF:{$Snippets.FullHdr}] [c/FF80FF:for this setting to have an effect]"
	RequireRenderModeFullHdr: "[c/FF00FF:{$Snippets.RenderMode}] [c/FF80FF:must be set to] [c/FF00FF:{$Snippets.FullHdr}] [c/FF80FF:for this setting to have an effect]"
	RequireLightMapBlurring: "[c/FF00FF:{$Snippets.LightMapBlurring}] [c/FF80FF:must be] [c/FF00FF:enabled] [c/FF80FF:for this setting to have an effect]"
	RequireNormalMaps: "[c/FF00FF:{$Snippets.NormalMaps}] [c/FF80FF:must be] [c/FF00FF:enabled] [c/FF80FF:for this setting to have an effect]"
	RequireGlobalIllumination: "[c/FF00FF:{$Snippets.GlobalIllumination}] [c/FF80FF:must be] [c/FF00FF:enabled] [c/FF80FF:for this setting to have an effect]"
	RequireFancyAtmosphere: "[c/FF00FF:{$Snippets.FancyAtmosphere}] [c/FF80FF:must be] [c/FF00FF:enabled] [c/FF80FF:for this setting to have an effect]"
	RequireFancySkyLightColors: "[c/FF00FF:{$Snippets.FancySkyLightColors}] [c/FF80FF:must be] [c/FF00FF:enabled] [c/FF80FF:for this setting to have an effect]"
	RequireFancySkyLightShading: "[c/FF00FF:{$Snippets.FancySkyLightShading}] [c/FF80FF:must be] [c/FF00FF:enabled] [c/FF80FF:for this setting to have an effect]"
}
